# Apenas valores de desenvolvimento local. Nunca versione segredos reais.
DATABASE_URL=postgres://casei:casei@localhost:5432/casei
# Administrative connection used only by `db:migrate` to create roles and apply migrations.
DATABASE_URL_MIGRATION=postgres://casei:casei@localhost:5432/casei
# Conexão administrativa usada somente pelo teste PostgreSQL descartável.
DATABASE_URL_TEST=postgres://casei:casei@localhost:5432/postgres
# Role sem BYPASSRLS usada pelo runtime; migrations podem conceder SET ROLE ao login abaixo.
DATABASE_ROLE=casei_app
DATABASE_ROLE_GRANTEE=
BETTER_AUTH_SECRET=substitua-por-um-segredo-com-ao-menos-32-caracteres
# Segredo para assinar cursores privados de listagens financeiras.
CASEI_CURSOR_SECRET=substitua-por-um-segredo-com-ao-menos-32-caracteres
# Storage temporário S3-compatible; credenciais podem vir da cadeia IAM do SDK.
CASEI_OBJECT_STORAGE_BUCKET=
CASEI_OBJECT_STORAGE_REGION=us-east-1
CASEI_OBJECT_STORAGE_ENDPOINT=
CASEI_OBJECT_STORAGE_ACCESS_KEY_ID=
CASEI_OBJECT_STORAGE_SECRET_ACCESS_KEY=
CASEI_OBJECT_STORAGE_FORCE_PATH_STYLE=false
CASEI_OBJECT_STORAGE_MAX_BYTES=10000000
CASEI_OBJECT_STORAGE_MAX_TTL_MS=86400000
BETTER_AUTH_URL=http://localhost:3001
CASEI_WEB_ORIGIN=http://localhost:3000
# Origem pública da API, incorporada no bundle do PWA durante `next build`.
NEXT_PUBLIC_CASEI_API_ORIGIN=http://localhost:3001
# Origem pública canônica do PWA para callbacks de verificação de e-mail.
NEXT_PUBLIC_CASEI_WEB_ORIGIN=http://localhost:3000
# Fixtures da UI somente para desenvolvimento/testes locais; produção deve permanecer 0.
CASEI_UI_FIXTURES=0
# Origens exatas aceitas em callbacks/CORS, separadas por vírgula.
CASEI_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# SMTP autenticado/TLS obrigatório em produção; testes usam CaptureTransactionalEmailPort.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM=Casei <no-reply@example.com>
SMTP_USER=
SMTP_PASSWORD=
API_PORT=3001
